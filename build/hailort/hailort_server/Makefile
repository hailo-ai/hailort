	cd /home/jordan/hailort/build && $(MAKE) $(MAKESILENT) -f hailort/hailort_server/CMakeFiles/hailort_server.dir/build.make hailort/hailort_server/CMakeFiles/hailort_server.dir/server_main.cpp.s
.PHONY : server_main.cpp.s

