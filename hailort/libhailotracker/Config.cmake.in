@PACKAGE_INIT@

if(TARGET hailotracker)
    if(HailoTracker_FIND_VERSION)
        # Extract major version from requested version
        string(REGEX REPLACE "^([0-9]+).*" "\\1" FIND_MAJOR_VER "${HailoTracker_FIND_VERSION}")
        # Only create alias if major versions match
        if("${FIND_MAJOR_VER}" STREQUAL "${HAILO_TRACKER_MAJOR_VERSION}")
            add_library(HailoTracker::hailotracker ALIAS hailotracker)
        endif()
    endif()
else()
    include("${CMAKE_CURRENT_LIST_DIR}/HailoTrackerTargets.cmake")
    check_required_components(HailoTracker)
endif()
